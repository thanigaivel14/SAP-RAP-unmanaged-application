unmanaged implementation in class zbp_i_travel_u unique;
strict ( 2 );

define behavior for zi_travel_u alias travel
implementation in class zbp_travel_u unique
late numbering
lock master
authorization master ( global )
etag master Lastchangedat
{
  create;
  update;
  delete;
  field ( readonly ) TravelId, Lastchangedby;
  field ( mandatory ) AgencyId, CustomerId, BeginDate, EndDate;
  association _booking { create ( features : instance ); }

  mapping for /dmo/travel control /dmo/s_travel_intx
    {
      AgencyId      = agency_id;
      BeginDate     = begin_date;
      BookingFee    = booking_fee;
      CurrencyCode  = currency_code;
      CustomerId    = customer_id;
      EndDate       = end_date;
      Description   = description;
      Status        = status;
      TotalPrice    = total_price;
      TravelId      = travel_id;
      Lastchangedat = lastchangedat;
      Createdat     = createdat;
      Createdby     = createdby;
    }


}

define behavior for zi_book_u alias booking
implementation in class zbp_booking_u unique
late numbering
lock dependent by _Travel
authorization dependent by _Travel
etag dependent by _Travel
{
  update;
  delete;
  field ( readonly ) TravelId, BookingId;
  field ( mandatory ) CarrierId, ConnectionId;
  association _Travel;
  mapping for /dmo/booking
  control /dmo/s_booking_intx
    {
      CarrierId    = carrier_id;
      ConnectionId = connection_id;
      BookingDate  = booking_date;
      BookingId    = booking_id;
      CurrencyCode = currency_code;
      FlightDate   = flight_date;
      FlightPrice  = flight_price;
      TravelId     = travel_id;
      CustomerId   = customer_id;
    }

}